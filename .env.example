# Copy to .env and fill in your own key. The real .env is ignored by Git.
PAPER_SCORING_BASE_URL=https://sub2api.starapi.net/v1
PAPER_SCORING_MODEL=deepseek-v4.1-flash
PAPER_SCORING_API_KEY=replace-me

# PDF page images are sent only when the model requests a visual check.
PAPER_SCORING_PDF_IMAGES=true
PAPER_SCORING_TIMEOUT=180
PAPER_SCORING_MAX_OUTPUT_TOKENS=8192

# Optional path to an embeddable Chinese TrueType font for PDF reports.
# PAPER_SCORING_PDF_FONT=/path/to/ChineseFont.ttf
